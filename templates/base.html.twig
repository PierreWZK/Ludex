<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Ludex · L'index de votre ludothèque, en API{% endblock %}</title>
    <meta name="description" content="{% block description %}Une API REST pour gérer sa collection de jeux vidéo : plateformes, statut, temps de jeu, note, liste d'envies, succès Steam et jeu du jour.{% endblock %}">
    <meta name="theme-color" content="#111113">
    {% block meta %}<meta name="robots" content="noindex">{% endblock %}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Ludex">
    <meta property="og:title" content="{{ block('title') }}">
    <meta property="og:description" content="{{ block('description') }}">
    <meta property="og:image" content="https://ludex.projectp.fr/og.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/ludex.css?v=3">
</head>
<body>
<div class="wrap">
    <nav class="nav" aria-label="Navigation principale">
        <a class="logo" href="/">lude<b>x</b></a>
        <div class="nav-liens">
            {% set page = page|default('demo') %}
            <a href="/" {{ page == 'demo' ? 'aria-current="page"' }}>Démo</a>
            <a href="/jeu" {{ page == 'jeu' ? 'aria-current="page"' }}>Jeu du jour</a>
            <a href="/api/docs">Swagger</a>
        </div>
        <div class="nav-droite">
            <a class="code" href="https://github.com/PierreWZK/Ludex" aria-label="Code sur GitHub">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
            </a>
            <a class="pastille-api" id="compte-lien" href="/connexion"><i></i><span>Se connecter</span></a>
        </div>
    </nav>

    {% block body %}{% endblock %}
</div>

<footer>
    <div class="wrap">
        <span>Ludex · Jour 11 du défi <a href="https://projectp.fr/">30 jours, 30 projets</a></span>
        <span>Symfony · API Platform · MySQL · <a href="https://github.com/PierreWZK/Ludex">Code sur GitHub</a></span>
    </div>
</footer>

<script src="/ludex.js?v=3"></script>
{% block scripts %}{% endblock %}
</body>
</html>
